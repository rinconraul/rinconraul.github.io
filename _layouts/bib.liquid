---
---
{%- comment -%}
  One publication row (used by every {% bibliography %} list on the site).
  Left: kind + year. Right: title, authors, venue, note, award, text links.
  Kind comes from the entry type; @unpublished uses `status`, @misc uses `category`
  (dataset, algorithm, software, other).
{%- endcomment -%}
{%- assign t = entry.type -%}
{%- if t == 'article' -%}
  {%- assign kind = 'Journal' -%}
{%- elsif t == 'inproceedings' or t == 'conference' -%}
  {%- assign kind = 'Conference' -%}
{%- elsif t == 'incollection' or t == 'inbook' or t == 'book' -%}
  {%- assign kind = 'Book chapter' -%}
{%- elsif t == 'techreport' -%}
  {%- assign kind = 'Report' -%}
{%- elsif t == 'phdthesis' or t == 'mastersthesis' or t == 'thesis' -%}
  {%- assign kind = 'Thesis' -%}
{%- elsif t == 'unpublished' -%}
  {%- if entry.status == 'accepted' -%}{%- assign kind = 'Accepted' -%}
  {%- elsif entry.status == 'inreview' -%}{%- assign kind = 'In review' -%}
  {%- else -%}{%- assign kind = 'Preprint' -%}{%- endif -%}
{%- elsif t == 'misc' -%}
  {%- if entry.category -%}{%- assign kind = entry.category | capitalize -%}{%- else -%}{%- assign kind = 'Other' -%}{%- endif -%}
{%- else -%}
  {%- assign kind = t | capitalize -%}
{%- endif -%}

{%- if entry.html -%}
  {%- if entry.html contains '://' -%}{%- assign main_link = entry.html -%}{%- else -%}{%- assign main_link = entry.html | prepend: '/assets/html/' | relative_url -%}{%- endif -%}
{%- elsif entry.doi -%}
  {%- assign main_link = entry.doi | prepend: 'https://doi.org/' -%}
{%- elsif entry.url -%}
  {%- assign main_link = entry.url -%}
{%- else -%}
  {%- assign main_link = nil -%}
{%- endif -%}

{%- comment -%}
  `note` is not displayed (it holds import leftovers like "Number: 550" or "In Spanish").
  Exception: for @unpublished it carries the journal and status, so it becomes the venue.
{%- endcomment -%}
{%- if t == 'unpublished' and entry.note -%}
  {%- assign venue = entry.note -%}
{%- elsif t == 'article' -%}
  {%- assign venue = entry.journal -%}
{%- elsif entry.booktitle -%}
  {%- assign venue = entry.booktitle -%}
{%- elsif t == 'techreport' and entry.institution -%}
  {%- assign venue = entry.institution -%}
{%- elsif entry.howpublished -%}
  {%- assign venue = entry.howpublished -%}
{%- elsif entry.publisher -%}
  {%- assign venue = entry.publisher -%}
{%- else -%}
  {%- assign venue = nil -%}
{%- endif -%}

<div class="asps-pub" id="{{ entry.key }}">
  <div class="asps-pub-meta">
    <span class="kind">{{ kind }}</span>
    <b>{{ entry.year }}</b>
  </div>

  <div class="asps-pub-body">
    <div class="title">
      {%- if main_link -%}<a href="{{ main_link }}" target="_blank" rel="noopener">{{ entry.title }}</a>{%- else -%}{{ entry.title }}{%- endif -%}
    </div>

    <div class="author">
      {%- assign author_array_size = entry.author_array | size -%}
      {%- assign author_array_limit = author_array_size -%}
      {%- if site.max_author_limit and author_array_size > site.max_author_limit -%}
        {%- assign author_array_limit = site.max_author_limit -%}
      {%- endif -%}
      {%- for author in entry.author_array limit: author_array_limit -%}
        {%- assign author_is_self = false -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
          {%- assign author_is_self = true -%}
        {%- endif -%}
        {%- comment -%} first names become initials so every list reads the same {%- endcomment -%}
        {%- assign initials = '' -%}
        {%- assign first_parts = author.first | replace: '.', ' ' | replace: '-', ' ' | split: ' ' -%}
        {%- for part in first_parts -%}
          {%- assign c = part | slice: 0 -%}
          {%- if c != '' -%}{%- assign initials = initials | append: c | append: '. ' -%}{%- endif -%}
        {%- endfor -%}
        {%- assign initials = initials | strip -%}
        {%- if forloop.first == false -%}
          {%- if forloop.last and author_array_limit == author_array_size -%}{%- if forloop.length > 2 -%}, and {% else %} and {% endif -%}{%- else -%}, {% endif -%}
        {%- endif -%}
        {%- if author_is_self -%}
          <b>{{ initials }} {{ author_last_html }}</b>
        {%- else -%}
          {{ initials }} {{ author_last_html }}
        {%- endif -%}
      {%- endfor -%}
      {%- assign more_authors = author_array_size | minus: author_array_limit -%}
      {%- if more_authors > 0 -%}
        , and {{ more_authors }} more
      {%- endif -%}
    </div>

    {%- capture venue_line -%}
      {%- if venue -%}<em>{{ venue }}</em>{%- endif -%}
      {%- if entry.publisher and t != 'article' and entry.publisher != venue -%}{%- if venue -%}, {% endif -%}{{ entry.publisher }}{%- endif -%}
      {%- if entry.address -%}{%- if venue -%}, {% endif -%}{{ entry.address }}{%- endif -%}
    {%- endcapture -%}
    {%- assign venue_text = venue_line | strip_html | strip -%}
    {%- if venue_text != '' -%}
      <div class="periodical">{{ venue_line }}</div>
    {%- endif -%}
    {%- if entry.award_name or entry.award -%}
      <div class="award-line">
        {%- if entry.award_name -%}{{ entry.award_name }}{%- else -%}{{ entry.award | markdownify | remove: '<p>' | remove: '</p>' | strip }}{%- endif -%}
      </div>
    {%- endif -%}

    <div class="links">
      {%- if entry.award_name and entry.award -%}<a class="award" role="button">Award details</a>{%- endif -%}
      {%- if entry.abstract -%}<a class="abstract" role="button">Abstract</a>{%- endif -%}
      {%- if entry.doi -%}<a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener">DOI</a>{%- endif -%}
      {%- if entry.arxiv -%}<a href="http://arxiv.org/abs/{{ entry.arxiv }}" target="_blank" rel="noopener">arXiv</a>{%- endif -%}
      {%- if entry.html -%}<a href="{{ main_link }}" target="_blank" rel="noopener">Link</a>{%- endif -%}
      {%- if entry.pdf -%}
        {%- if entry.pdf contains '://' -%}<a href="{{ entry.pdf }}">PDF</a>{%- else -%}<a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}">PDF</a>{%- endif -%}
      {%- endif -%}
      {%- if entry.code -%}<a href="{{ entry.code }}" target="_blank" rel="noopener">Code</a>{%- endif -%}
      {%- if entry.supp -%}
        {%- if entry.supp contains '://' -%}<a href="{{ entry.supp }}">Supplement</a>{%- else -%}<a href="{{ entry.supp | prepend: '/assets/pdf/' | relative_url }}">Supplement</a>{%- endif -%}
      {%- endif -%}
      {%- if entry.slides -%}
        {%- if entry.slides contains '://' -%}<a href="{{ entry.slides }}">Slides</a>{%- else -%}<a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}">Slides</a>{%- endif -%}
      {%- endif -%}
      {%- if entry.poster -%}
        {%- if entry.poster contains '://' -%}<a href="{{ entry.poster }}">Poster</a>{%- else -%}<a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}">Poster</a>{%- endif -%}
      {%- endif -%}
      {%- if entry.video -%}<a href="{{ entry.video }}" target="_blank" rel="noopener">Video</a>{%- endif -%}
      {%- if entry.website -%}<a href="{{ entry.website }}" target="_blank" rel="noopener">Website</a>{%- endif -%}
      {%- if entry.bibtex_show -%}<a class="bibtex" role="button">BibTeX</a>{%- endif -%}
    </div>

    {%- if entry.award_name and entry.award -%}
      <div class="award hidden">{{ entry.award | markdownify }}</div>
    {%- endif -%}
    {%- if entry.abstract -%}
      <div class="abstract hidden"><p>{{ entry.abstract }}</p></div>
    {%- endif -%}
    {%- if entry.bibtex_show -%}
      <div class="bibtex hidden">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}
      </div>
    {%- endif -%}
  </div>
</div>
