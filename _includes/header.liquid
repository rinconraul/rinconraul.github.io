<header class="asps-masthead" id="asps-top">
  <div class="asps-wrap">
    <a class="asps-wordmark" href="{{ '/' | relative_url }}">{{ site.title }}</a>
    {% if site.group.affiliation %}
      <div class="asps-affil">
        <a class="asps-affil-uni" href="{{ site.group.affiliation_url }}" target="_blank" rel="noopener">{{ site.group.affiliation }}</a>
        <a class="asps-affil-dept" href="{{ site.group.department_url }}" target="_blank" rel="noopener">{{ site.group.department }}</a>
      </div>
    {% endif %}
  </div>
</header>

<!-- Tab navigation: built from pages with `nav: true`, sorted by `nav_order` -->
<nav class="asps-nav" id="asps-nav" role="navigation" aria-label="Main">
  <div class="asps-wrap">
    <a class="asps-dock" href="{{ '/' | relative_url }}" tabindex="-1" aria-hidden="true">{{ site.title }}</a>
    <ul class="asps-tabs" id="asps-tabs">
      {% for p in site.pages %}
        {% if p.permalink == '/' %}{% assign about_title = p.title %}{% endif %}
      {% endfor %}
      <li>
        <a class="asps-tab {% if page.permalink == '/' %}on{% endif %}" href="{{ '/' | relative_url }}">
          {{- about_title -}}
        </a>
      </li>

      {% assign sorted_pages = site.pages | sort: 'nav_order' %}
      {% for p in sorted_pages %}
        {% if p.nav and p.autogen == null %}
          {% if p.dropdown %}
            {% assign has_active_child = false %}
            {% for child in p.children %}
              {% if page.title == child.title %}{% assign has_active_child = true %}{% endif %}
            {% endfor %}
            <li class="dropdown">
              <a
                class="asps-tab dropdown-toggle {% if page.title == p.title or has_active_child %}on{% endif %}"
                href="#"
                role="button"
                data-toggle="dropdown"
                aria-haspopup="true"
                aria-expanded="false"
              >
                {{- p.title -}}
              </a>
              <div class="dropdown-menu asps-menu">
                {% for child in p.children %}
                  {% if child.title == 'divider' %}
                    <div class="dropdown-divider"></div>
                  {% else %}
                    <a
                      class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                      href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                    >
                      {{- child.title -}}
                    </a>
                  {% endif %}
                {% endfor %}
              </div>
            </li>
          {% else %}
            {% assign parent_link = p.permalink | remove: 'index.html' %}
            {%- if p.permalink contains '://' -%}
              {%- assign url = p.permalink -%}
            {%- elsif p.permalink contains '/blog/' -%}
              {%- assign url = '/blog/' -%}
            {%- else -%}
              {%- assign url = p.url -%}
            {%- endif %}
            <li>
              <a class="asps-tab {% if page.url contains parent_link %}on{% endif %}" href="{{ url | relative_url }}">
                {{- p.title -}}
              </a>
            </li>
          {% endif %}
        {% endif %}
      {% endfor %}
      <span class="asps-ind" id="asps-ind" aria-hidden="true"></span>
    </ul>
  </div>
</nav>

<script>
  (function () {
    var nav = document.getElementById("asps-nav");
    var top = document.getElementById("asps-top");
    if (nav && top && "IntersectionObserver" in window) {
      new IntersectionObserver(
        function (e) {
          nav.classList.toggle("stuck", !e[0].isIntersecting);
        },
        { rootMargin: "-1px 0px 0px 0px" }
      ).observe(top);
    }
    // tab indicator rests on the current page and follows the pointer
    var tabs = document.getElementById("asps-tabs");
    var ind = document.getElementById("asps-ind");
    if (!tabs || !ind) return;
    var cur = tabs.querySelector(".asps-tab.on");
    function place(a) {
      if (!a) {
        ind.style.width = "0";
        return;
      }
      var t = tabs.getBoundingClientRect(),
        r = a.getBoundingClientRect();
      ind.style.left = r.left - t.left + "px";
      ind.style.width = r.width + "px";
    }
    tabs.querySelectorAll(".asps-tab").forEach(function (a) {
      a.addEventListener("mouseenter", function () {
        place(a);
      });
    });
    tabs.addEventListener("mouseleave", function () {
      place(cur);
    });
    window.addEventListener("resize", function () {
      place(cur);
    });
    place(cur);
    if (document.fonts && document.fonts.ready)
      document.fonts.ready.then(function () {
        place(cur);
      });
  })();
</script>
